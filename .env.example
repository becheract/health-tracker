# Postgres connection string (Neon, Vercel Postgres, Supabase, or local)
DATABASE_URL=postgres://user:password@host:5432/health

# The one Google account allowed to sign in (also the Gmail inbox that is read)
ALLOWED_EMAIL=you@gmail.com

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials, type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public URL of the app, used for the OAuth redirect: <APP_URL>/api/auth/google/callback
APP_URL=http://localhost:3000

# Random 32+ character string used to sign the session cookie
SESSION_SECRET=

# Gmail push notifications: Pub/Sub topic the Gmail watch publishes to
GMAIL_PUBSUB_TOPIC=projects/your-project/topics/gmail-health
# Secret added to the push subscription URL: <APP_URL>/api/gmail/push?token=<value>
PUBSUB_VERIFICATION_TOKEN=

# Vercel sends this as a Bearer token on cron requests
CRON_SECRET=

# Optional: which emails count as results (Gmail search syntax)
# GMAIL_QUERY=from:(pchealth.ca OR pharmasmart OR lifeclinic OR higi) OR subject:"blood pressure"
# Optional: time zone the kiosks print their timestamps in
# READINGS_TIME_ZONE=America/Toronto
